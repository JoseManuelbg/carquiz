# Plantilla. Copia a .env.local y rellena con tu proyecto de Supabase.
# NUNCA pongas claves reales aquí: este fichero SÍ se sube al repo.

# --- Base de datos (Supabase → Project Settings → Database → Connection string) ---
# Pooled (Transaction, puerto 6543). La usa la app en runtime.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Directa (puerto 5432). Solo para migraciones / seed.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- API de Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
# Clave pública (nuevo nombre: "publishable", empieza por sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY="<publishable key>"
# Solo servidor. Salta RLS: lee fotos del bucket privado y escribe desde /admin.
# (nuevo nombre: "secret", empieza por sb_secret_...) NUNCA la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY="<secret key>"

# Bucket de fotos (créalo PRIVADO).
SUPABASE_PHOTO_BUCKET="car-photos"

# URL pública (canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL="https://tu-dominio.vercel.app"

# Usuario de Ko-fi (ko-fi.com/ESTO). Vacío = no se muestra el botón.
NEXT_PUBLIC_KOFI_USERNAME=""
